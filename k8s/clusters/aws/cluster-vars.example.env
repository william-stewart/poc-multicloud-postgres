# Variables Flux substitutes into k8s/platform/aws. bootstrap.sh fills the real
# values from `tofu output` and the cluster, and stores them in the
# flux-system/cluster-vars ConfigMap. make validate renders the manifests with
# these examples and fails if a manifest uses a variable not listed here.
EKS_API_HOST=0123456789ABCDEF0123456789ABCDEF.gr7.us-east-1.eks.amazonaws.com
EKS_DNS_SERVICE_IP=172.20.0.10
CILIUM_OPERATOR_ROLE_ARN=arn:aws:iam::123456789012:role/poc-mcpg-cilium-operator
