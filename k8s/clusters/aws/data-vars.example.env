# Variables Flux substitutes into k8s/data/aws and k8s/policies/aws.
# `make data-vars` fills the real values from `tofu output` in
# infra/30-data/aws (the primary's S3 archive) and infra/30-data/gcp (the
# replica's GCS archive, which the primary reads after a switchover) and
# stores them in the flux-system/data-vars ConfigMap. make validate renders
# the manifests with these examples.
WAL_BUCKET=poc-mcpg-wal-123456789012-us-east-1
WAL_WRITER_ROLE_ARN=arn:aws:iam::123456789012:role/poc-mcpg-wal-writer
WAL_BUCKET_REGION=us-east-1
GCS_WAL_BUCKET=poc-test-project-poc-mcpg-wal
