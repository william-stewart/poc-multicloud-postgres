# Variables Flux substitutes into k8s/data/gcp and k8s/policies/gcp.
# `make data-vars` fills the real values from `tofu output` in
# infra/30-data/aws (the primary's S3 archive) and infra/30-data/gcp (the
# replica's own GCS archive) and stores them in the flux-system/data-vars
# ConfigMap. make validate renders the manifests with these examples.
WAL_BUCKET=poc-mcpg-wal-123456789012-us-east-1
WAL_BUCKET_REGION=us-east-1
GCS_WAL_BUCKET=poc-test-project-poc-mcpg-wal
GCS_WAL_WRITER_SA=poc-mcpg-wal-writer@poc-test-project.iam.gserviceaccount.com
