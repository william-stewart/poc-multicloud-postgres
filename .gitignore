# OpenTofu
**/.terraform/*
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfplan
tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!example.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# keep .terraform.lock.hcl committed

# Credentials and local secrets
secrets/
.env
.env.*
kubeconfig*
*.kubeconfig
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*credentials*.json

# Tool output and OS noise
.DS_Store
.tflint.d/

# Backend settings saved locally (account-specific)
*.backend.hcl
backend.hcl

# Checkov downloads external modules here
.external_modules/

# Reusable modules: the calling stack's lock file is the one that applies
infra/modules/**/.terraform.lock.hcl

# End-to-end test and live drill diagnostics (the evidence/ summaries are committed)
test/e2e/results/
test/live/results/
